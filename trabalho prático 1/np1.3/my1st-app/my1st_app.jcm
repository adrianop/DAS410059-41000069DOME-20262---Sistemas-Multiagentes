/*
    my1st_app
    ---------------------------

    JaCaMo Application File

    This file defines the initial state of the MAS (initial agents, environment, organisation, ....)

    (see jacamo/doc/jcm.html for more information about what can be defined in this file)

    JaCaMo 1.3.1
    setembro 14, 2026 - 09:28:27
*/

/*
    Contract Net Protocol parameters (see ../../tp-cnp.pdf):
        n = number of initiators               (1 < n < 200)
        m = number of participants              (1 < m < 50)
        i = parallel contracts per initiator    (0 < i < 10)

    n and m are simulated with "instances", as suggested by the JaCaMo
    manual (https://jacamo-lang.github.io/jacamo/jcm.html): "instances: 5"
    creates 5 copies of the agent (initiator1..initiator5, and likewise for
    participant). i is passed as the shared belief n_contracts/1 below.
*/

mas my1st_app {

    agent initiator : cnp_initiator.asl {
        instances: 3
        beliefs:   n_participants(4), n_contracts(1)
    }

    agent participant : cnp_participant.asl {
        instances: 4
        beliefs:   service(delivery)
    }

}